# Neon connection string. Use the pooled ("-pooler") host for the web process,
# and keep sslmode=require. Prisma migrations should run against the direct
# (non-pooled) host if your Neon project splits them.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/parseskill?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/parseskill?sslmode=require"

# Auth
JWT_SECRET="change-me"
JWT_ALGORITHM="HS256"
SESSION_COOKIE_NAME="ps_session"
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# GitHub OAuth (mandatory signup path)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/auth/callback/github"
GITHUB_OAUTH_SCOPES="read:user user:email public_repo"

# Frontend origin (CORS + post-login redirect)
FRONTEND_URL="http://localhost:3000"

# Neon Auth (Stack Auth) — second sign-in path shown next to GitHub in the
# UI. Base issuer URL from the Neon console's "Auth" tab for this project.
NEON_AUTH_ISSUER_URL=""

# LLM provider for the AI Career Assistant (Section 5.6 / 6.4)
LLM_PROVIDER="anthropic" # anthropic | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Storage
STORAGE_DIR="./storage"

# Optional external sources
LEETCODE_SESSION_TOKEN=""
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# Observability (optional in dev)
SENTRY_DSN=""
POSTHOG_API_KEY=""

ENVIRONMENT="development"
